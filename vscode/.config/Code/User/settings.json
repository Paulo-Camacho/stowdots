{
  "editor.fontLigatures": true,
  "debug.onTaskErrors": "debugAnyway",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
  },
  "svelte.enable-ts-plugin": true,
  "files.autoSave": "afterDelay",
  "editor.minimap.enabled": false,
  "terminal.integrated.initialHint": false,
  "workbench.startupEditor": "none",
  "git.autofetch": true,
  "claudeCode.preferredLocation": "panel",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.wordWrap": "on",
  "explorer.compactFolders": false,
  "redhat.telemetry.enabled": false,
  "window.title": "${activeEditorLong}${separator}${rootName}${separator}${appName}",
  "scm.diffDecorations": "all",
  "scm.diffDecorationsGutterWidth": 3,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "workbench.settings.applyToAllProfiles": [
    
  ],
  // "window.zoomLevel": 0.5,
  "github.copilot.nextEditSuggestions.eagerness": "medium",
  "vim.useSystemClipboard": true,
  "vim.visualModeKeyBindings": [
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "J"
      ],
      "commands": [
        "editor.action.moveLinesDownAction"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.moveLinesUpAction"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "$"
      ]
    },
    {
      "before": [
        ";"
      ],
      "after": [
        ":"
      ]
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "$"
      ]
    },
    {
      "before": [
        ";"
      ],
      "after": [
        ":"
      ]
    }
  ],
  "vim.highlightedyank.enable": true,
  // "vim.highlightedyank.color": "rgba(250, 240, 170, 0.5)",
  "vim.highlightedyank.duration": 300,
  "explorer.confirmDragAndDrop": false,
"workbench.iconTheme": "bearded-icons",
"editor.fontFamily": "''Iosevka Nerd Font Mono', JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
"editor.fontSize": 12,
"chat.fontSize": 12,
"terminal.integrated.fontFamily": "Iosevka Nerd Font Mono",
"github.copilot.enable": {
  "*": false,
  "plaintext": false,
  "markdown": false,
  "scminput": false
},
"workbench.colorTheme": "cursor anysphere theme",
"C_Cpp.intelliSenseEngine": "disabled",
}
