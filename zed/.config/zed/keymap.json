// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "vim_mode == normal && !menu", 
    "bindings": {
      ";": ["workspace::SendKeystrokes", ":"],
      "space .": "project_panel::ToggleFocus",
      "space p c": ["workspace::SendKeystrokes", "0i- [ ] "],
      "space p x": ["workspace::SendKeystrokes", "F[lrx"],
      "shift-h": "vim::StartOfLine",
      "shift-l": "vim::EndOfLine"
    }

  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "shift-k": "editor::MoveLineUp",
      "shift-j": "editor::MoveLineDown"
    }
  },
  {
    "context": "VimControl && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "g j": "vim::Down",
      "g k": "vim::Up"
    }
  }
]
