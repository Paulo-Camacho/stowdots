.DS_Store

# Zed prompt-library state (binary LMDB, machine-local)
zed/.config/zed/prompts/

# VS Code: ~/.config/Code is stow-folded into this repo, so only track real config
vscode/.config/Code/*
!vscode/.config/Code/User/
vscode/.config/Code/User/*
!vscode/.config/Code/User/settings.json
!vscode/.config/Code/User/keybindings.json
!vscode/.config/Code/User/extensions.txt
!vscode/.config/Code/User/snippets/

# VSCodium: ~/.config/VSCodium is stow-folded into this repo, so only track real config
vscodium/.config/VSCodium/*
!vscodium/.config/VSCodium/User/
vscodium/.config/VSCodium/User/*
!vscodium/.config/VSCodium/User/settings.json
!vscodium/.config/VSCodium/User/keybindings.json
!vscodium/.config/VSCodium/User/extensions.txt
!vscodium/.config/VSCodium/User/snippets/
